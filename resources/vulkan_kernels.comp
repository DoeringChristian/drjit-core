#version 460
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x_id = 0) in;

layout(buffer_reference, buffer_reference_align = 1) buffer U8 { uint8_t v; };
layout(buffer_reference, buffer_reference_align = 2) buffer U16 { uint16_t v; };
layout(buffer_reference, buffer_reference_align = 4) buffer U32 { uint32_t v; };
layout(buffer_reference, buffer_reference_align = 8) buffer U64 { uint64_t v; };

// ============================================================================
//  aggregate -- populate a per-vcall data buffer from a list of entries.
//  Refer to the CUDA version of this kernel in misc.cuh for more details.
// ============================================================================

#if defined(AGGREGATE)
struct AggregationEntry {
    int16_t size;
    uint16_t resource_kind; // ignored
    uint32_t offset;
    uint64_t src;
};

layout(buffer_reference, std430, buffer_reference_align = 16) readonly buffer
AggregationEntries { AggregationEntry e[]; };

layout(push_constant) uniform Params {
    uint64_t dst;
    AggregationEntries in_;
    uint32_t size;
} params;

void main() {
    uint32_t stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint32_t i = gl_GlobalInvocationID.x; i < params.size; i += stride) {
        AggregationEntry rec = params.in_.e[i];
        uint64_t dst = params.dst + rec.offset;

        switch (int(rec.size)) {
            case  1: U8(dst).v  = uint8_t(rec.src); break;
            case  2: U16(dst).v = uint16_t(rec.src); break;
            case  4: U32(dst).v = uint32_t(rec.src); break;
            case  8: U64(dst).v = rec.src; break;
            case -1: U8(dst).v  = U8(rec.src).v; break;
            case -2: U16(dst).v = U16(rec.src).v; break;
            case -4: U32(dst).v = U32(rec.src).v; break;
            case -8: U64(dst).v = U64(rec.src).v; break;
        }
    }
}
#endif

// ============================================================================
//  deinterleave / interleave -- convert between the interleaved channels of a
//  texture in linear memory and the packed 1/2/4-channel layout of one of its
//  sub-textures. Refer to the Metal version of these kernels in
//  metal_kernels.metal for more details.
// ============================================================================

#if defined(DEINTERLEAVE_U8) || defined(INTERLEAVE_U8)
#  define T uint8_t
#  define REF U8
#  define T_SIZE uint64_t(1)
#elif defined(DEINTERLEAVE_U16) || defined(INTERLEAVE_U16)
#  define T uint16_t
#  define REF U16
#  define T_SIZE uint64_t(2)
#elif defined(DEINTERLEAVE_U32) || defined(INTERLEAVE_U32)
#  define T uint32_t
#  define REF U32
#  define T_SIZE uint64_t(4)
#endif

#if defined(T)
layout(push_constant) uniform Params {
    uint64_t src;
    uint64_t dst;
    uint32_t n_channels; // Channels per texel in the interleaved layout
    uint32_t ci;         // Channels per texel in the packed layout (1, 2, or 4)
    uint32_t tex_base;   // First interleaved channel of this sub-texture
    uint32_t c_valid;    // Number of real channels (the rest is padding)
    uint32_t size;       // Number of values to write
} params;

void main() {
    uint32_t stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint32_t i = gl_GlobalInvocationID.x; i < params.size; i += stride) {
#if defined(DEINTERLEAVE_U8) || defined(DEINTERLEAVE_U16) || defined(DEINTERLEAVE_U32)
        uint64_t pix = i / params.ci;
        uint32_t c = i % params.ci;
        T value = T(0);
        if (c < params.c_valid)
            value = REF(params.src + (pix * params.n_channels +
                                      params.tex_base + c) * T_SIZE).v;
        REF(params.dst + uint64_t(i) * T_SIZE).v = value;
#else
        uint64_t pix = i / params.c_valid;
        uint32_t c = i % params.c_valid;
        REF(params.dst + (pix * params.n_channels + params.tex_base + c) *
                             T_SIZE).v =
            REF(params.src + (pix * params.ci + c) * T_SIZE).v;
#endif
    }
}
#endif
